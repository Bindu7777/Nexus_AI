{
  "servers": {
    "nexus": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "tsx",
        "services/mcp/server.ts"
      ]
    },
    "nexus-ide": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "run",
        "--silent",
        "dev:ide"
      ]
    }
  }
}
