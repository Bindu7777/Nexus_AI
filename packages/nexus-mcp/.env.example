# nexus-mcp settings. Copy to .env (or set in your container / Helm values).
#
# Nexus never needs Jira, GitHub, database or docs credentials in IDE mode:
# the engineer's IDE tools sign in as the engineer. Do not add any here.

# ---- storage ----
# Where Nexus keeps investigations, the audit log and sign-in data.
# Local stdio default: ~/.nexus/ide.sqlite. Container: /data/ide.sqlite.
NEXUS_IDE_DB=

# ---- local stdio mode ----
# Company id for investigations started on this machine.
NEXUS_IDE_COMPANY=local
# 1 = the seeded demo company (sandbox catalog and rule engine), for trying it out.
NEXUS_IDE_DEMO=0
# MCP client names allowed to send approvals (the Nexus VS Code extension).
NEXUS_APPROVER_CLIENTS=nexus-vscode

# ---- HTTP mode (nexus-mcp --http) ----
NEXUS_HTTP_HOST=127.0.0.1
NEXUS_HTTP_PORT=4320
# The address engineers' IDEs use. Must be https unless it is a loopback address.
NEXUS_PUBLIC_URL=https://nexus.example.internal

# Sign-in with your company's identity provider (OAuth 2.1 / OIDC).
# Tokens must name this server as their audience (default <NEXUS_PUBLIC_URL>/mcp)
# and carry the nexus.investigate scope; approving also needs nexus.approve.
NEXUS_OIDC_ISSUER=
NEXUS_OIDC_JWKS_URL=
NEXUS_OIDC_AUDIENCE=
# The company this install serves, or the token claim that names it.
NEXUS_OIDC_COMPANY=
NEXUS_OIDC_COMPANY_CLAIM=
NEXUS_OIDC_ALGORITHMS=RS256,ES256

# Built-in username and password sign-in for pilots. On when no OIDC issuer is
# set. Add users with: nexus-mcp user add <login> <company-id>
NEXUS_PILOT_LOGIN=0
